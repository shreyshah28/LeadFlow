# LeadFlow Backend Environment Configuration

# Optional: Override database connection for PostgreSQL deployment
# DATABASE_URL=postgresql://postgres:password@localhost:5432/leadflow

# Optional: Host and Port configuration
# PORT=8000
# HOST=0.0.0.0

# Automatic Daily Follow-up Email Configuration (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# EMAIL_FROM=LeadFlow CRM <your-account@gmail.com>
# FOLLOWUP_EMAIL_TO=manager@company.com
# DAILY_FOLLOWUP_EMAIL_ENABLED=true
# DAILY_FOLLOWUP_TIMEZONE=Asia/Kolkata
# CRON_SECRET=your-random-secret-token-here
