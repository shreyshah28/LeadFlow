# ==============================================================================
# LeadFlow Project Root .gitignore
# ==============================================================================

# Database files & SQLite journals (Protect local data & backups)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
leadflow.db
*backup*.db
test_*.db

# Python virtual environments & bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Node.js dependencies & builds
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

